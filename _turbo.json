{
  "$schema": "https://turbo.build/schema.json",
  "ui": "tui",
  "tasks": {
    "website#build": {
      "dependsOn": ["^build"],
      "inputs": ["$TURBO_DEFAULT$", ".env*", "apps/website/.env*"],
      "outputs": ["apps/website/.next/**", "!apps/website/.next/cache/**"],
      "env": [
        "NEXT_PUBLIC_HOST_URL",
        "MONGODB_URI",
        "JWT_SECRET",
        "SHOPIFY_API_KEY",
        "SHOPIFY_API_SECRET",
        "SHOPIFY_APP_URL",
        "SHOPIFY_SHOP_NAME",
        "SHOPIFY_ACCESS_TOKEN",
        "NEXT_PUBLIC_SHOP_DOMAIN",
        "SHOPIFY_STOREFRONT_ACCESS_TOKEN"
      ]
    },
    "website#dev": {
      "cache": false,
      "persistent": true,
      "env": ["NEXT_PUBLIC_WEBSITE_API_URL", "DATABASE_URL"]
    },

    "landing#build": {
      "dependsOn": ["^build"],
      "inputs": ["$TURBO_DEFAULT$", ".env*", "apps/landing/.env*"],
      "outputs": ["apps/landing/.next/**", "!apps/landing/.next/cache/**"],
      "env": [
        "NEXT_PUBLIC_LANDING_API_URL",
        "NEXT_PUBLIC_GTM_ID",
        "NEXT_PUBLIC_MARKETING_EMAIL"
      ]
    },
    "landing#dev": {
      "cache": false,
      "persistent": true,
      "env": ["NEXT_PUBLIC_LANDING_API_URL"]
    },

    "lint": {
      "dependsOn": ["^lint"]
    },
    "check-types": {
      "dependsOn": ["^check-types"]
    }
  }
}
